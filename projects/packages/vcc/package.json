{
    "name": "@valkyrie-language/vcc",
    "version": "0.0.6",
    "description": "Valkyrie compiler collect — orthogonal native N-API bindings and wasm spawn helpers (no CLI aggregation).",
    "type": "module",
    "license": "MPL-2.0",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./legion": "./src/products/legion.ts",
        "./asgard": "./src/products/asgard.ts",
        "./testing": "./src/testing.ts",
        "./execution-manifest": "./src/execution-manifest.ts",
        "./benchmark": "./src/benchmark.ts"
    },
    "optionalDependencies": {
        "@valkyrie-language/vcc-win32-x64": "workspace:*",
        "@valkyrie-language/vcc-linux-x64": "workspace:*",
        "@valkyrie-language/vcc-darwin-x64": "workspace:*",
        "@valkyrie-language/vcc-darwin-arm64": "workspace:*",
        "@valkyrie-language/vcc-unknown-wasm32": "workspace:*",
        "@valkyrie-language/vcc-wasm32-wasi": "workspace:*"
    },
    "files": [
        "src",
        "README.md"
    ],
    "scripts": {
        "test": "node --test tests/**/*.test.ts"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "valkyrie",
        "vcc",
        "compiler",
        "legion",
        "asgard",
        "host-runner"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/valkyrie-language/valkyrie.rs.git",
        "directory": "projects/packages/vcc"
    },
    "bugs": {
        "url": "https://github.com/valkyrie-language/valkyrie.rs/issues"
    },
    "homepage": "https://github.com/valkyrie-language/valkyrie.rs/tree/main/projects/packages/vcc#readme",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@valkyrie-language/vcc-unknown-wasm32": "workspace:*",
        "@valkyrie-language/vcc-wasm32-wasi": "workspace:*"
    }
}
