{
    "name": "@valkyrie-language/legion",
    "version": "0.0.7",
    "description": "Legion — Valkyrie compiler CLI (@vmz/commander); orthogonal build/plan via @valkyrie-language/vcc N-API.",
    "type": "module",
    "license": "MPL-2.0",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "bin": {
        "legion": "bin/legion.js"
    },
    "files": [
        "bin",
        "src",
        "README.md"
    ],
    "scripts": {
