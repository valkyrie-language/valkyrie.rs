    "repository": {
        "type": "git",
        "url": "git+https://github.com/valkyrie-language/valkyrie.rs.git",
        "directory": "projects/packages/legion"
    },
    "bugs": {
        "url": "https://github.com/valkyrie-language/valkyrie.rs/issues"
    },
    "homepage": "https://github.com/valkyrie-language/valkyrie.rs/tree/main/projects/packages/legion#readme",
    "publishConfig": {
        "access": "public"
    }
