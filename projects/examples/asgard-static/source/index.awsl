<widget index>
<Column class="hero">
    <Text class="hero-title">{greeting}</Text>
    <Text class="state-label" id="state-label">Label: {label}</Text>
    <Input class="label-input" value="{label}" />
    <Button class="toggle-button" @click="turn_on">Turn on</Button>
    <Button class="toggle-button" @click="turn_off">Turn off</Button>
    <Button class="rebuild-button" @click="rebuild_island">Rebuild island</Button>
</Column>
</widget>
<script>
let greeting: utf8 = "你好，静态世界"
let mut label: utf8 = "off"

micro turn_on() {
    label = "on"
}

micro turn_off() {
    label = "off"
}

micro rebuild_island() {
    dom_unmount_islands()
    dom_mount_islands()
}
</script>
<style>
root {
    color: @warn
    spacing: 8
}
#state-label { text: @title }
</style>
