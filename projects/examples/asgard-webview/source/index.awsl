<widget index>
<Column class="desk">
    <Text class="desk-title" id="desk-title">{title}</Text>
    <Text class="desk-subtitle" id="desk-subtitle">{subtitle}</Text>
    <Text class="desk-status" id="desk-status">{status}</Text>
    <Button @click="on_refresh">Refresh</Button>
</Column>
</widget>
<script>
let title: utf8 = "Valkyrie Desk"
let subtitle: utf8 = "WebView desktop host example"
let mut status: utf8 = "All services online"
micro on_refresh() {
    status = "Refreshed just now"
}
</script>
<style>
root { inset: 24 }
#desk-title { text: @title }
#desk-status { text: @body }
</style>
