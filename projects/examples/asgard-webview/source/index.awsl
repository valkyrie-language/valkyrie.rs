<widget index>
<Column class="desk">
    <Text class="desk-title">{title}</Text>
    <Text class="desk-subtitle">{subtitle}</Text>
    <Text class="desk-status">{status}</Text>
    <Button @click="on_refresh">Refresh</Button>
</Column>
</widget>
<script>
let title: utf8 = "Valkyrie Desk"
let subtitle: utf8 = "WebView desktop host example"
let mut status: utf8 = "All services online"
micro on_refresh() {
    status = "Refreshed just now"
}
</script>
<style>
.desk { padding: 24px; }
.desk-title { font-size: 20px; }
.desk-status { font-family: monospace; }
</style>
