<widget index>
<Column class="lifecycle">
    <Text class="mark-line" id="mark-line">Mark: {label}</Text>
    <Button class="mark-button" @click="mark">Mark</Button>
    <Button class="rebuild-button" @click="rebuild_island">Rebuild island</Button>
</Column>
</widget>
<script>
let mut active: bool = false
let mut label: utf8 = "off"
micro mark() {
    if active {
        label = "off"
        active = false
    }
    else {
        label = "on"
        active = true
    }
}
micro rebuild_island() {
    dom_unmount_islands()
    dom_mount_islands()
}
</script>
<style>
root { inset: 16 }
#mark-line {
    text: @body
    height: 20
}
</style>
