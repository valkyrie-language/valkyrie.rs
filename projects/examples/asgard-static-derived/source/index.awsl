<widget index>
<Column class="derived">
    <Text class="status-label" id="status-label">Status: {status}</Text>
    <Button class="advance-button" @click="advance">Advance</Button>
    <Text class="message-label" id="message-label">{message}</Text>
    <Button class="shout-button" @click="shout">Shout</Button>
</Column>
</widget>
<script>
let mut is_green: bool = false
let mut status: utf8 = "red"
let mut message: utf8 = "hello"
micro advance() {
    if is_green {
        status = "red"
        is_green = false
    }
    else {
        status = "green"
        is_green = true
    }
}
micro shout() {
    message = "louder"
}
</script>
<style>root { inset: 16 }
#status-label { text: @body }
#message-label { color: @brand }</style>
