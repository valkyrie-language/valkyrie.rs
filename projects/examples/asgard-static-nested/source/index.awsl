<widget index>
<Column class="page">
    <Row class="header" id="header">
        <Text class="brand">Console</Text>
        <Button class="nav-toggle primary" id="nav-toggle" @click="toggle_nav">Menu</Button>
    </Row>
    <Row class="content" id="content">
        <Column class="sidebar" id="sidebar">
            <Text class="nav-state">Nav: {nav}</Text>
        </Column>
        <Column class="main" id="main">
            <Input class="note-input" value="{note}" />
            <Text class="note-echo">Note: {note}</Text>
            <Button class="clear-note secondary" id="clear-note" @click="clear_note">Clear</Button>
        </Column>
    </Row>
</Column>
</widget>
<script>
let mut nav_open: bool = true
let mut nav: utf8 = "open"
let mut note: utf8 = "first"
micro toggle_nav() {
    if nav_open {
        nav = "closed"
        nav_open = false
    }
    else {
        nav = "open"
        nav_open = true
    }
}
micro clear_note() {
    note = ""
}
</script>
<style>root { direction: vertical }
#header {
    direction: horizontal
    main-align: space-between
}
#content { direction: horizontal }
#sidebar { width: 160 }
#main { width: fill }
#nav-toggle { text: @title }
#clear-note { color: @ink-muted }</style>
